OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Seconds to wait for Gemma; the first call after startup also loads the model into memory.
OLLAMA_TIMEOUT=120
# Gemma calls per request before falling back to demo missions.
AI_ATTEMPTS=2
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_PATH=outdoor.db
